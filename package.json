{
    "name": "rerun-monorepo",
    "license": "AGPL-3.0-only",
    "description": "Rerun: AI coworkers that run your work",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@8.15.4",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "postinstall": "([ ! -f scripts/install-cloud.mjs ] || node scripts/install-cloud.mjs) && ([ ! -f scripts/install-git-hooks.mjs ] || node scripts/install-git-hooks.mjs)",
        "cloud": "pnpm --dir cloud",
        "build:contracts": "pnpm --filter @rerun/contracts build",
        "build": "pnpm -r build",
        "dev:engine": "pnpm --filter rerun-engine dev",
        "dev:ui": "pnpm --filter rerun dev",
        "dev:ui:full": "concurrently -k -n next,engine -c cyan,green \"pnpm --filter rerun dev\" \"pnpm --filter rerun-engine dev\"",
        "dev:mobile": "node scripts/dev-mobile.mjs",
        "verify:ui": "node scripts/verify-ui.mjs",
        "test": "node --test scripts/self-host-check.test.mjs",
        "security:start": "node scripts/security-start.mjs",
        "dev:landing": "pnpm --dir cloud/apps/landing dev",
        "dev:emails": "pnpm --filter @rerun/emails dev",
        "dev:docs": "cd apps/docs && npx --yes mint dev --port 3333",
        "check:docs": "cd apps/docs && npx --yes mint validate && npx --yes mint broken-links",
        "typecheck": "pnpm -r --if-present ts-check",
        "db:new": "supabase migration new",
        "db:start": "supabase start",
        "db:stop": "supabase stop",
        "db:reset": "supabase db reset",
        "db:fresh:local": "supabase start && supabase db reset"
    },
    "devDependencies": {
        "@react-email/preview-server": "5.2.10",
        "concurrently": "^10.0.4",
        "react-email": "6.11.6",
        "supabase": "^2.113.0",
        "typescript": "^5.8.3"
    },
    "pnpm": {
        "patchedDependencies": {
            "ai-sdk-provider-codex-cli@1.3.1": "apps/engine/patches/ai-sdk-provider-codex-cli@1.3.1.patch"
        },
        "overrides": {
            "next": "16.4.4",
            "dompurify": "^3.4.17",
            "shell-quote": "^1.11.0",
            "proxy-addr": "^2.0.8",
            "axios": "^1.20.0",
            "fast-uri": "^3.1.9",
            "follow-redirects": "^1.16.2",
            "undici@6": "^6.29.1",
            "sharp": "^0.35.5",
            "body-parser": "^2.4.0",
            "ip-address": "^10.7.5",
            "markdown-it": "^14.3.3",
            "systeminformation": "^5.33.19",
            "engine.io": "^6.6.11",
            "node-forge": "^1.4.2",
            "nanoid@3": "^3.3.20",
            "ws@8": "^8.22.1",
            "js-yaml@3": "^3.15.2",
            "js-yaml@4": "^4.3.2",
            "brace-expansion@1": "^1.1.21",
            "brace-expansion@5": "^5.0.12",
            "socket.io-parser": "^4.2.7",
            "postcss": "^8.5.23",
            "source-map-js": "^1.2.2",
            "browserslist": "^4.29.5",
            "basic-ftp": "^6.2.5",
            "deepmerge-ts": "^8.0.2",
            "vite": "^8.3.5",
            "@anthropic-ai/claude-agent-sdk": "0.3.317"
        }
    }
}
